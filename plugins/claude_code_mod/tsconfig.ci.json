{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": [
    "hooks/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts"
  ]
}
